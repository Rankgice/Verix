{
  "manifest_version": "1",
  "protocol_version": "1.0",
  "id": "com.verix.dao",
  "name": "dao",
  "display_name": "DAO Generator",
  "version": "1.1.0",
  "description": "根据数据库表结构生成符合 Go GORM Model Standards 的 DAO 层代码",
  "runtime": {
    "command": "dao-plugin.exe",
    "args": [],
    "activation": "lazy",
    "startup_timeout_ms": 5000,
    "call_timeout_ms": 30000,
    "shutdown_timeout_ms": 3000,
    "max_concurrent_calls": 2,
    "restart_policy": "on_failure",
    "max_restarts": 3
  },
  "permissions": [],
  "methods": [
    {
      "name": "generate",
      "description": "连接 MySQL，读取指定表结构；mode=code 返回源码，mode=file 按表名写入 output_dir 并仅返回文件信息。file 模式允许多表，生成 <output_dir>/<table>.go，已有文件会覆盖。",
      "input_schema": {
        "type": "object",
        "properties": {
          "dsn": {
            "type": "string",
            "description": "MySQL 连接串，含用户名和密码，例如 root:pass@tcp(127.0.0.1:3306)/mydb?parseTime=true"
          },
          "tables": {
            "type": "array",
            "items": { "type": "string" },
            "description": "要生成 model 的表名列表"
          },
          "package_name": {
            "type": "string",
            "description": "生成的包名，默认 model"
          },
          "mode": {
            "type": "string",
            "enum": ["code", "file"],
            "description": "code 返回源码（默认）；file 将源码写入 output_dir 并不返回 code"
          },
          "output_dir": {
            "type": "string",
            "description": "file 模式必填；输出目录不存在会自动创建，每张表生成 <output_dir>/<table>.go，已有文件会覆盖"
          }
        },
        "required": ["dsn", "tables"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "table": { "type": "string" },
                "entity": { "type": "string" },
                "package": { "type": "string" },
                "code": { "type": "string" },
                "path": { "type": "string" },
                "bytes": { "type": "integer" },
                "sha256": { "type": "string" },
                "created": { "type": "boolean" },
                "overwritten": { "type": "boolean" }
              },
              "required": ["table", "entity", "package"],
              "additionalProperties": false
            }
          }
        },
        "required": ["files"],
        "additionalProperties": false
      },
      "flags": {
        "read_only": false,
        "idempotent": true,
        "supports_cancellation": true
      }
    },
    {
      "name": "list_tables",
      "description": "连接 MySQL 数据库并列出当前数据库的所有表",
      "input_schema": {
        "type": "object",
        "properties": {
          "dsn": {
            "type": "string",
            "description": "MySQL 连接串，含用户名和密码"
          }
        },
        "required": ["dsn"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "tables": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["tables"],
        "additionalProperties": false
      },
      "flags": {
        "read_only": true,
        "idempotent": true
      }
    }
  ]
}
